---
import SubpageLayout from '../../components/SubpageLayout.astro';
import { nearby } from '../../data/nearby';

export function getStaticPaths() { return nearby.map(item => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const path = `/nearby/${item.slug}/`;
const title = `${item.name}景點攻略｜歷史特色、交通、路線與拍照位置｜基隆海洋廣場周邊`;
const description = `${item.name}（${item.en}）怎麼去？整理${item.area}的歷史背景、特色、開放資訊、遊覽路線、拍攝重點及專屬 Google 地圖導航。`;
const jsonLd = [JSON.stringify({ '@context':'https://schema.org', '@type':'TouristAttraction', name:item.name, alternateName:item.en, description:item.intro, url:`https://keelungmaritimeplaza.com${path}`, hasMap:item.maps, address:{'@type':'PostalAddress',addressLocality:'基隆市',addressCountry:'TW'}, isAccessibleForFree: item.fee.includes('免') || item.fee.includes('無需') }), JSON.stringify({ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem',position:1,name:'基隆海洋廣場',item:'https://keelungmaritimeplaza.com/' },{ '@type':'ListItem',position:2,name:'周邊景點',item:'https://keelungmaritimeplaza.com/nearby/' },{ '@type':'ListItem',position:3,name:item.name,item:`https://keelungmaritimeplaza.com${path}` }] })];
---
<SubpageLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="subhero"><div class="shell"><p class="kicker">{item.tag} · 基隆周邊景點</p><h1>{item.name}<br /><span class="nearby-en">{item.en}</span></h1><p class="subhero-lead">{item.intro}</p><div class="subhero-actions"><a class="button button-solid" href={item.maps} target="_blank" rel="noopener noreferrer">Google 地圖定位 ↗</a><a class="button button-ghost" href="/nearby/">更多周邊景點</a></div></div></section>
  <section class="section nearby-detail"><div class="shell"><figure class="nearby-feature-photo"><img src={item.image} alt={item.imageAlt} width="1200" height="750" fetchpriority="high" /><figcaption>{item.name}實景 · <a href={item.imageSource} target="_blank" rel="noopener noreferrer">查看照片來源 ↗</a></figcaption></figure><div class="section-heading"><p class="kicker">行前資訊</p><h2>{item.name}基本資料</h2><p>位於{item.area}。出發前請以現場資訊核實門牌、票價與開放時段。</p></div><dl class="nearby-facts"><div><dt>位置區域</dt><dd>{item.area}</dd></div><div><dt>開放資訊</dt><dd>{item.hours}</dd></div><div><dt>門票</dt><dd>{item.fee}</dd></div><div><dt>建議停留</dt><dd>{item.time}</dd></div><div><dt>交通方式</dt><dd>{item.transport}</dd></div><div><dt>地圖</dt><dd><a href={item.maps} target="_blank" rel="noopener noreferrer">查看此景點專屬位置 ↗</a></dd></div></dl></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">認識景點</p><h2>歷史背景與特色</h2></div><div class="nearby-columns"><article><h3>港城歷史與文化</h3><p>{item.history}</p></article><article><h3>建築與觀察重點</h3><p>{item.feature}</p></article></div></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">遊覽建議</p><h2>從海洋廣場出發的路線</h2></div><ol class="nearby-steps">{item.route.map(step => <li>{step}</li>)}</ol><div class="nearby-columns"><article><h3>攝影機位與光線</h3><p>{item.photo}</p></article><article><h3>遊覽須知</h3><p>{item.tip}</p><p>下雨時注意防滑與防風。若安排親子或長輩同行，請依同行者步行能力調整停留時間。</p></article></div></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">行程串聯</p><h2>交通、周邊與常見問題</h2></div><div class="nearby-columns"><article><h3>怎麼去？</h3><p>{item.transport}。從海洋廣場銜接市區步道時，請以行人號誌及現場路標為準。</p><h3>如何安排半日行程？</h3><p>可先在<a href="/">海洋廣場</a>賞港景，接著參訪本景點，最後依時間接上<a href="/nearby/">其他周邊景點</a>。若需要搭車，請預留候車與交通時間。</p></article><article><h3>需要預約或付費嗎？</h3><p>{item.fee}。{item.hours}，特殊活動或維護期間可能不同。</p><h3>附近住宿怎麼選？</h3><p>想看港灣晨昏可考慮基隆車站、港西街或市中心一帶的住宿；比較交通便利性、夜間步行路線與實際房價後再決定。</p></article></div><p class="nearby-source">參考資料：<a href={item.source} target="_blank" rel="noopener noreferrer">基隆市文化觀光局相關景點介紹 ↗</a>。地點導航採 Google 地圖專屬名稱搜尋，尚未取得逐一驗證的 Place ID。本文未引用未核實的 Google 評分或評論數。</p><a class="button button-solid" href={item.maps} target="_blank" rel="noopener noreferrer">開啟{item.name}地圖 ↗</a></div></section>
</SubpageLayout>
