---
import SubpageLayout from '../../components/SubpageLayout.astro';
import { nearby } from '../../data/nearby';

export function getStaticPaths() { return nearby.map(item => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const path = `/nearby/${item.slug}/`;
const title = `${item.name}景點攻略｜歷史特色、交通、路線與拍照位置｜基隆海洋廣場周邊`;
const description = `${item.name}（${item.en}）怎麼去？整理${item.area}的歷史背景、特色、開放資訊、遊覽路線、拍攝重點及專屬 Google 地圖導航。`;
const companionPlaces = nearby.filter(p => p.slug !== item.slug).slice(0, 4);
const jsonLd = [JSON.stringify({ '@context':'https://schema.org', '@type':'TouristAttraction', name:item.name, alternateName:item.en, description:item.intro, url:`https://keelungmaritimeplaza.com${path}`, image:`https://keelungmaritimeplaza.com${item.image}`, hasMap:item.maps, address:{'@type':'PostalAddress',addressLocality:'基隆市',addressCountry:'TW'}, isAccessibleForFree: item.fee.includes('免') || item.fee.includes('無需') }), JSON.stringify({ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem',position:1,name:'基隆海洋廣場',item:'https://keelungmaritimeplaza.com/' },{ '@type':'ListItem',position:2,name:'周邊景點',item:'https://keelungmaritimeplaza.com/nearby/' },{ '@type':'ListItem',position:3,name:item.name,item:`https://keelungmaritimeplaza.com${path}` }] }), JSON.stringify({ '@context':'https://schema.org', '@type':'FAQPage', mainEntity:item.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}})) })];
---
<SubpageLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="subhero"><div class="shell"><p class="kicker">{item.tag} · 基隆周邊景點</p><h1>{item.name}<br /><span class="nearby-en">{item.en}</span></h1><p class="subhero-lead">{item.intro}</p><div class="nearby-hero-meta"><span>{item.area}</span><span>建議停留 {item.time}</span><span>{item.hours}</span></div><div class="subhero-actions"><a class="button button-solid" href={item.maps} target="_blank" rel="noopener noreferrer">Google 地圖定位 ↗</a><a class="button button-ghost" href="/nearby/">更多周邊景點</a></div></div></section>
  <section class="section nearby-about"><div class="shell"><div class="nearby-about-card"><p class="kicker">關於景點</p><h2>關於{item.name}</h2><p>{item.about}</p><h3>管理與維護主體</h3><p>{item.manager}</p><a class="text-link text-link-dark" href={item.managerSource} target="_blank" rel="noopener noreferrer">查看管理單位／主管機關資料 ↗</a></div></div></section>
  <section class="section nearby-detail"><div class="shell"><figure class="nearby-feature-photo"><img src={item.image} alt={item.imageAlt} width="1200" height="750" fetchpriority="high" /><figcaption>{item.name}實景 · <a href={item.imageSource} target="_blank" rel="noopener noreferrer">查看照片來源 ↗</a></figcaption></figure><div class="section-heading"><p class="kicker">探索與基本資訊</p><h2>{item.name}基本資料</h2><p>{item.intro} 位於{item.area}；出發前請以現場資訊核實門牌、票價與開放時段。</p></div><dl class="nearby-facts"><div><dt>景點正式名稱</dt><dd>{item.name}（{item.en}）</dd></div><div><dt>景點類型</dt><dd>{item.tag}</dd></div><div><dt>地址／位置</dt><dd>{item.area}</dd></div><div><dt>開放資訊</dt><dd>{item.hours}</dd></div><div><dt>門票</dt><dd>{item.fee}</dd></div><div><dt>建議停留</dt><dd>{item.time}</dd></div><div><dt>交通方式</dt><dd>{item.transport}</dd></div><div><dt>地圖</dt><dd><a href={item.maps} target="_blank" rel="noopener noreferrer">查看此景點專屬位置 ↗</a></dd></div></dl></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">開放與交通</p><h2>參觀時段、票價及抵達方式</h2><p>不同景點可能是全天公共空間、營運館舍或港口工作區，請依實際場域安排。</p></div><div class="nearby-columns nearby-three"><article><h3>開放時間</h3><p>{item.hours}</p><p>如遇活動、天候或場地維修，以管理單位最新公告為準。</p></article><article><h3>門票價格</h3><p>{item.fee}</p><p>收費設施可能有優惠、預約或不同館區的票種。</p></article><article><h3>交通方式</h3><p>{item.transport}</p><p><a href={item.maps} target="_blank" rel="noopener noreferrer">開啟對應地點的 Google 地圖 ↗</a></p></article></div></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">發現魅力</p><h2>歷史背景、建築與文化特色</h2><p>{item.detail}</p></div><div class="nearby-columns"><article><h3>歷史與文化脈絡</h3><p>{item.history}</p></article><article><h3>建築與現場觀察</h3><p>{item.feature}</p></article></div></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">遊覽建議</p><h2>從海洋廣場出發的路線</h2></div><ol class="nearby-steps">{item.route.map(step => <li>{step}</li>)}</ol><div class="nearby-columns"><article><h3>攝影機位與光線</h3><p>{item.photo}</p></article><article><h3>遊覽須知</h3><p>{item.tip}</p><p>下雨時注意防滑與防風。若安排親子或長輩同行，請依同行者步行能力調整停留時間。</p></article></div></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">交通與周邊</p><h2>從港邊出發的半日行程</h2></div><div class="nearby-columns"><article><h3>交通方式</h3><p>{item.transport}。從海洋廣場銜接市區步道時，請依行人號誌及現場路標通行。</p><h3>順路安排</h3><p>先在<a href="/">海洋廣場</a>賞港景，接著參訪{item.name}，最後選擇<a href="/nearby/">更多周邊景點</a>串聯半日或一日行程。</p></article><article><h3>住宿與休息</h3><p>基隆車站、港西街與市中心一帶有不同類型住宿，適合安排晨昏兩次港景。價格、房況與無障礙設施應向住宿業者確認。</p><h3>訪客體驗</h3><p>可以優先觀察：{item.feature}。本站不代寫旅客評論；實際評分與評論請開啟景點 Google 地圖查看。</p></article></div></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">常見問題</p><h2>前往{item.name}前先了解</h2></div><div class="nearby-faq">{item.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}<details><summary>門票與開放時段如何安排？</summary><p>{item.fee}；{item.hours}。行程如遇節日、活動或整修，建議先查看現場與管理單位公告。</p></details><details><summary>從海洋廣場步行或搭車方便嗎？</summary><p>{item.transport}。若遇大雨、港邊強風或行動不便，應調整交通方式與停留時間。</p></details></div><p class="nearby-source">資料參考：<a href={item.source} target="_blank" rel="noopener noreferrer">基隆市文化觀光局景點介紹 ↗</a> · <a href={item.managerSource} target="_blank" rel="noopener noreferrer">管理資訊 ↗</a></p><a class="button button-solid" href={item.maps} target="_blank" rel="noopener noreferrer">開啟{item.name}專屬 Google 地圖 ↗</a></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">附近值得同遊</p><h2>接續探索基隆周邊</h2><p>依照港邊、市中心或海岸路線串聯景點，點選後可閱讀各自的完整指南。</p></div><div class="nearby-grid nearby-photo-grid nearby-related">{companionPlaces.map(p=><article><a href={`/nearby/${p.slug}/`}><img src={p.image} alt={p.imageAlt} width="600" height="400" loading="lazy" /></a><span>{p.tag}</span><h3><a href={`/nearby/${p.slug}/`}>{p.name} →</a></h3><p>{p.intro}</p></article>)}</div><p class="nearby-source"><a class="text-link text-link-dark" href="/nearby/">查看全部周邊景點與路線 →</a></p></div></section>
</SubpageLayout>
