---
import SubpageLayout from '../../../components/SubpageLayout.astro';
import { nearby } from '../../../data/nearby';
import { nearbyRoutes } from '../../../data/nearby-routes';
export function getStaticPaths(){ return nearbyRoutes.map(route=>({params:{slug:route.slug},props:{route}})); }
const {route}=Astro.props;
const path=`/nearby/routes/${route.slug}/`;
const first=nearby.find(p=>p.slug===route.steps[0].slug)!;
const itinerary=route.steps.map((s,i)=>({ ...s, index:i+1, attraction:nearby.find(p=>p.slug===s.slug)! }));
const jsonLd=[JSON.stringify({'@context':'https://schema.org','@type':'TouristTrip',name:route.name,description:route.intro,url:`https://keelungmaritimeplaza.com${path}`}),JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'海洋廣場',item:'https://keelungmaritimeplaza.com/'},{'@type':'ListItem',position:2,name:'周邊景點',item:'https://keelungmaritimeplaza.com/nearby/'},{'@type':'ListItem',position:3,name:route.name,item:`https://keelungmaritimeplaza.com${path}`} ]})];
---
<SubpageLayout title={`${route.name}｜交通、路線、時間與地圖｜基隆海洋廣場`} description={`${route.intro} 整理${route.duration}的逐站路線、歷史文化、交通與拍照建議。`} path={path} ogImage={`https://keelungmaritimeplaza.com${route.image}`} mapUrl={first.maps} jsonLd={jsonLd}>
  <section class="subhero"><div class="shell"><p class="kicker">基隆周邊主題路線</p><h1>{route.name}</h1><p class="subhero-lead">{route.subtitle}</p><div class="nearby-hero-meta"><span>建議時間 {route.duration}</span><span>{route.transport}</span></div><div class="subhero-actions"><a class="button button-solid" href={first.maps} target="_blank" rel="noopener noreferrer">第一站 Google 地圖 ↗</a><a class="button button-ghost" href="/nearby/">周邊景點總覽</a></div></div></section>
  <section class="section nearby-about"><div class="shell"><div class="nearby-about-card"><p class="kicker">路線介紹</p><h2>為什麼這樣安排？</h2><p>{route.intro}</p><h3>各地點的管理方式</h3><p>本路線跨越不同場域：公共廣場、市街、展館與園區分別由其管理單位維護；開放時間、收費與活動規範並不相同。請點開各景點的獨立專頁，核對當日營運資訊。</p></div></div></section>
  <section class="section nearby-detail"><div class="shell"><figure class="nearby-feature-photo"><img src={route.image} alt={route.alt} width="1200" height="750"/><figcaption>路線代表地點實景；各站專頁另有對應景點照片</figcaption></figure><div class="section-heading"><p class="kicker">基本資訊</p><h2>出發前的行程速覽</h2></div><dl class="nearby-facts"><div><dt>路線名稱</dt><dd>{route.name}</dd></div><div><dt>建議遊覽</dt><dd>{route.duration}</dd></div><div><dt>交通方式</dt><dd>{route.transport}</dd></div><div><dt>開放資訊</dt><dd>{route.hours}</dd></div><div><dt>門票與費用</dt><dd>{route.fee}</dd></div><div><dt>第一站導航</dt><dd><a href={first.maps} target="_blank" rel="noopener noreferrer">{first.name} Google 地圖 ↗</a></dd></div></dl></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="section-heading"><p class="kicker">歷史與觀察</p><h2>看懂路線中的基隆</h2><p>{route.history}</p></div><div class="nearby-columns"><article><h3>建築、地形與核心體驗</h3><p>{route.focus}</p></article><article><h3>交通與抵達方式</h3><p>{route.transport}</p><p>導航請逐站使用不同的 Google 地圖連結，不要把整段路線定位到海洋廣場。</p></article></div></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">逐站步行與轉乘</p><h2>建議遊覽路線</h2><p>按順序查看每一站的具體地址、歷史、開放方式與個別導航。</p></div><ol class="nearby-steps">{itinerary.map(stop=><li><strong>{stop.attraction.name}</strong>：{stop.text} <a href={`/nearby/${stop.slug}/`}>完整景點攻略 →</a> · <a href={stop.attraction.maps} target="_blank" rel="noopener noreferrer">Google 地圖 ↗</a></li>)}</ol></div></section>
  <section class="section nearby-detail nearby-muted"><div class="shell"><div class="nearby-columns"><article><h3>遊覽須知</h3><p>{route.tips}</p><h3>拍照機位</h3><p>{route.photos}</p></article><article><h3>住宿與休息建議</h3><p>若想分兩天探索，可選基隆車站或市中心附近住宿；若以八斗子海岸為重點，需預留往返交通。實際房況與費用請向住宿業者核實。</p><h3>旅客評價</h3><p>各站有不同的 Google 地圖評價，請點選逐站專頁查看原始資料。本站不以同一分數代表整條路線，也不虛構評論。</p></article></div></div></section>
  <section class="section nearby-detail"><div class="shell"><div class="section-heading"><p class="kicker">常見問題</p><h2>規劃{route.name}時常問</h2></div><div class="nearby-faq">{route.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}<details><summary>下雨或景點暫停開放怎麼辦？</summary><p>{route.tips} 可從<a href="/nearby/">附近其他景點</a>選擇替代方案。</p></details></div><p class="nearby-source">參考：<a href="https://travel.klcg.gov.tw/" target="_blank" rel="noopener noreferrer">基隆旅遊網</a>與各站專頁列出的管理、開放資訊。</p></div></section>
</SubpageLayout>
