---
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>找不到頁面｜基隆海洋廣場</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0a2232] text-white">
    <main class="relative grid min-h-screen place-items-center overflow-hidden px-6 text-center">
      <img class="absolute inset-0 h-full w-full object-cover opacity-30" src="/images/photo-night.webp" alt="" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#071a27] via-[#071a27]/70 to-[#071a27]/20"></div>
      <div class="relative max-w-xl">
        <p class="text-sm font-extrabold tracking-[0.24em] text-[#e0a15d]">404・航線偏離</p>
        <h1 class="mt-4 text-5xl font-black tracking-tight sm:text-7xl">這裡沒有靠港</h1>
        <p class="mt-5 text-lg leading-8 text-white/70">你要找的頁面可能已經移動，回到海洋廣場指南重新出發吧。</p>
        <a class="mt-8 inline-flex rounded-full bg-[#d89a50] px-7 py-3 font-bold text-[#0a2232] no-underline transition hover:bg-[#e5ad6f]" href="/">返回首頁</a>
      </div>
    </main>
  </body>
</html>
