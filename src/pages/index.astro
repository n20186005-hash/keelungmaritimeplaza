    <script>
      const queryRequired = <T extends Element>(selector: string): T => {
        const element = document.querySelector<T>(selector);
        if (!element) throw new Error(`找不到必要的頁面元素：${selector}`);
        return element;
      };

      const timeData = {
        day: {
          label: '白天・視野最清楚',
          title: '適合第一次辨認港區與船隻',
          description: '上午至午後光線較充足，能清楚看見港區建築、船隻與山城輪廓。夏季遮陰有限，請留意防曬與補水。',
          notes: ['適合看船與認識周邊方向', '照片色彩清楚，手機也容易拍攝', '夏季午後體感可能炎熱'],
          image: '/images/photo-day.webp',
          alt: '白天的基隆海洋廣場與港灣',
          caption: '白天可清楚看見港區船隻與城市輪廓。'
        },
        dusk: {
          label: '黃昏・綜合體驗最佳',
          title: '從藍天一路等待城市燈光亮起',
          description: '建議在日落前30–45分鐘抵達。先看港區細節，再等待天空轉暗與水面反光，是最完整也最容易安排的時段。',
          notes: ['一次涵蓋白天、黃昏與夜景', '適合散步、約會與拍照', '結束後可接續市中心晚餐'],
          image: '/images/photo-panorama.webp',
          alt: '黃昏後從基隆海洋廣場望向基隆港',
          caption: '天色轉暗後，港灣燈光逐步成為主角。'
        },
        night: {
          label: '夜晚・雨港氣氛最鮮明',
          title: '看燈光、倒影與城市仍在運轉',
          description: '夜間適合欣賞港灣燈光與水面倒影。若剛下過雨，城市霓虹與濕潤地面會更有基隆辨識度。',
          notes: ['適合夜景與倒影拍攝', '可接續市中心與廟口周邊', '港邊風大時注意保暖'],
          image: '/images/photo-night.webp',
          alt: '夜間的基隆海洋廣場燈光與水面倒影',
          caption: '夜色與港水倒影構成基隆最鮮明的城市畫面。'
        },
        rain: {
          label: '雨天・最像基隆的日常',
          title: '濕潤木棧與灰藍城市別有氣氛',
          description: '雨天仍可前往，照片會呈現更柔和的灰藍色調。但木棧可能濕滑，港邊風勢也會放大體感。',
          notes: ['穿著防滑鞋，降低步行速度', '強風時雨衣通常比雨傘方便', '相機與手機需要做好防水'],
          image: '/images/photo-rain.webp',
          alt: '雨天的基隆海洋廣場與木棧平台',
          caption: '雨天有獨特氛圍，也需要更留意地面與風勢。'
        }
      } as const;

      type TimeKey = keyof typeof timeData;
      const isTimeKey = (value: string | undefined): value is TimeKey =>
        Boolean(value && value in timeData);
      const timeButtons = document.querySelectorAll<HTMLButtonElement>('[data-time]');
      const timeLabel = queryRequired<HTMLElement>('[data-time-label]');
      const timeTitle = queryRequired<HTMLElement>('[data-time-title]');
      const timeDescription = queryRequired<HTMLElement>('[data-time-description]');
      const timeNotes = queryRequired<HTMLUListElement>('[data-time-notes]');
      const timeImage = queryRequired<HTMLImageElement>('[data-time-image]');
      const timeCaption = queryRequired<HTMLElement>('[data-time-caption]');

      timeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.time;
          if (!isTimeKey(key)) return;
          const data = timeData[key];
          timeButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
          timeLabel.textContent = data.label;
          timeTitle.textContent = data.title;
          timeDescription.textContent = data.description;
          timeNotes.innerHTML = data.notes.map((note) => `<li>${note}</li>`).join('');
          timeImage.src = data.image;
          timeImage.alt = data.alt;
          timeCaption.textContent = data.caption;
        });
      });

      const routeData = {
        '30': {
          badge: '快速看港',
          title: '車站到港邊，完成最精簡的基隆散步',
          description: '適合轉車、帶著行李或遇上短暫放晴。重點是快速抵達港邊，不繞遠路。',
          duration: '約 30 分鐘',
          style: '輕鬆步行',
          steps: [
            ['基隆火車站南站出口', '出站後往港區方向前進', '起點'],
            ['國門廣場', '穿越車站與港區之間的開放空間', '約 2 分'],
            ['基隆海洋廣場', '看港景、拍照，沿木棧平台短暫散步', '停留 20 分']
          ]
        },
        '60': {
          badge: '完整散步',
          title: '慢慢走完整座廣場，等待一班船經過',
          description: '適合第一次來訪。除了拍照，也能找個位置停下來觀察船隻、黑鳶與港區作業。',
          duration: '約 1 小時',
          style: '港邊漫步',
          steps: [
            ['基隆火車站南站出口', '沿國門廣場方向前進', '起點'],
            ['國門廣場', '理解車站、市區與港區的位置關係', '停留 10 分'],
            ['海洋廣場木棧平台', '沿水邊完整散步並拍攝地標', '停留 30 分'],
            ['港邊休息區', '看船、吹風，再決定下一站', '停留 15 分']
          ]
        },
        '180': {
          badge: '城市串聯',
          title: '從港邊走進市中心，把海景接到在地街區',
          description: '適合午後或傍晚抵達。海洋廣場之後繼續探索慶安宮、市中心街道與廟口周邊。',
          duration: '約 3 小時',
          style: '港都步行',
          steps: [
            ['海洋廣場', '先看港景並確認天氣與光線', '停留 40 分'],
            ['國門廣場與車站周邊', '由港邊返回城市步行軸線', '約 15 分'],
            ['慶安宮周邊', '走入基隆市中心的歷史街區', '停留 30 分'],
            ['廟口周邊', '以晚餐或小吃結束行程', '停留 60 分']
          ]
        },
        half: {
          badge: '半日港都',
          title: '港灣、城市高處與夜市，一次看見基隆層次',
          description: '適合把海洋廣場當作起點，接上東岸港區、城市觀景與市中心晚餐。實際路線依天氣與體力調整。',
          duration: '約 4–5 小時',
          style: '多點串聯',
          steps: [
            ['基隆車站與國門廣場', '從城市門戶開始理解方向', '停留 20 分'],
            ['基隆海洋廣場', '港邊散步、看船與拍照', '停留 50 分'],
            ['東岸港區或市中心高處', '換一個角度看港口與山城', '停留 90 分'],
            ['市中心與廟口周邊', '用晚餐結束半日港都行程', '停留 90 分']
          ]
        }
      } as const;

      type RouteKey = keyof typeof routeData;
      const isRouteKey = (value: string | undefined): value is RouteKey =>
        Boolean(value && value in routeData);
      const routeButtons = document.querySelectorAll<HTMLButtonElement>('[data-route]');
      const routeBadge = queryRequired<HTMLElement>('[data-route-badge]');
      const routeTitle = queryRequired<HTMLElement>('[data-route-title]');
      const routeDescription = queryRequired<HTMLElement>('[data-route-description]');
      const routeDuration = queryRequired<HTMLElement>('[data-route-duration]');
      const routeStyle = queryRequired<HTMLElement>('[data-route-style]');
      const routeSteps = queryRequired<HTMLOListElement>('[data-route-steps]');

      routeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.route;
          if (!isRouteKey(key)) return;
          const data = routeData[key];
          routeButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
          routeBadge.textContent = data.badge;
          routeTitle.textContent = data.title;
          routeDescription.textContent = data.description;
          routeDuration.textContent = data.duration;
          routeStyle.textContent = data.style;
          routeSteps.innerHTML = data.steps.map((step, index) => `
            <li>
              <span>${String(index + 1).padStart(2, '0')}</span>
              <div><strong>${step[0]}</strong><small>${step[1]}</small></div>
              <em>${step[2]}</em>
            </li>`).join('');
        });
      });

      const lightbox = queryRequired<HTMLDialogElement>('[data-lightbox]');
      const lightboxImage = queryRequired<HTMLImageElement>('[data-lightbox-image]');
      const lightboxCaption = queryRequired<HTMLElement>('[data-lightbox-caption]');
      const lightboxClose = queryRequired<HTMLButtonElement>('[data-lightbox-close]');
      const galleryButtons = document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]');
      let lightboxOpener: HTMLButtonElement | null = null;

      galleryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          lightboxOpener = button;
          lightboxImage.src = button.dataset.gallerySrc ?? '';
          lightboxImage.alt = button.dataset.galleryAlt || '';
          lightboxCaption.textContent = button.dataset.galleryCaption || '';
          lightbox.showModal();
          lightboxClose.focus();
        });
      });
      lightboxClose.addEventListener('click', () => lightbox.close());
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('close', () => {
        lightboxImage.removeAttribute('src');
        lightboxOpener?.focus();
        lightboxOpener = null;
      });

      const header = queryRequired<HTMLElement>('[data-header]');
      const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 20);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
