---
import "../styles/global.css";

const mapNavigationUrl =
  "https://www.google.com/maps/dir/?api=1&destination=25.1309627%2C121.7413639";
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>基隆海洋廣場｜交通、夜景、郵輪與周邊散步指南</title>
    <meta name="description" content="基隆海洋廣場完整旅遊指南，整理開放時間、交通方式、最佳參觀時間、港灣夜景、郵輪觀賞、雨天提醒、實景照片及市中心步行路線。" />
    <meta name="theme-color" content="#123047" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href="https://keelungmaritimeplaza.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content="基隆海洋廣場｜從車站走進港灣的第一站" />
    <meta property="og:description" content="交通、最佳時間、真實照片、雨天提醒與30分鐘至半日散步路線。" />
    <meta property="og:url" content="https://keelungmaritimeplaza.com/" />
    <meta property="og:image" content="https://keelungmaritimeplaza.com/og/keelung-maritime-plaza-og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <script is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"TouristAttraction","name":"基隆海洋廣場","alternateName":"Keelung Maritime Plaza","description":"基隆港旁的開放式公共廣場，適合欣賞船隻、港灣風景、雨港景色與夜間燈光。","url":"https://keelungmaritimeplaza.com/","image":["https://keelungmaritimeplaza.com/images/hero-desktop.webp","https://keelungmaritimeplaza.com/images/photo-night.webp","https://keelungmaritimeplaza.com/images/photo-rain.webp"],"isAccessibleForFree":true,"publicAccess":true,"address":{"@type":"PostalAddress","streetAddress":"忠一路3-2號","addressLocality":"基隆市","addressRegion":"仁愛區","addressCountry":"TW"},"geo":{"@type":"GeoCoordinates","latitude":25.1309627,"longitude":121.7413639},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"00:00","closes":"23:59"}}</script>
    <script is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"基隆海洋廣場需要門票嗎？","acceptedAnswer":{"@type":"Answer","text":"不需要。這裡是免費開放的公共空間。"}},{"@type":"Question","name":"海洋廣場幾點關門？","acceptedAnswer":{"@type":"Answer","text":"基隆官方旅遊資料標示為24小時開放的開放式空間。"}},{"@type":"Question","name":"從基隆火車站怎麼去？","acceptedAnswer":{"@type":"Answer","text":"由基隆火車站南站出口步行約3至5分鐘即可抵達。"}},{"@type":"Question","name":"一定看得到郵輪嗎？","acceptedAnswer":{"@type":"Answer","text":"不一定。郵輪需依靠港計畫而定，但平時仍能欣賞港景與各類船隻。"}},{"@type":"Question","name":"建議停留多久？","acceptedAnswer":{"@type":"Answer","text":"單純散步與拍照約30至60分鐘；若等待黃昏或串聯市中心，可預留更久。"}},{"@type":"Question","name":"雨天適合前往嗎？","acceptedAnswer":{"@type":"Answer","text":"可以感受雨港氛圍，但木棧平台可能濕滑，港邊也可能風大。"}},{"@type":"Question","name":"海洋廣場有專屬停車場嗎？","acceptedAnswer":{"@type":"Answer","text":"建議使用基隆車站、市中心或東岸周邊停車場，再步行前往。"}},{"@type":"Question","name":"海洋廣場和國門廣場一樣嗎？","acceptedAnswer":{"@type":"Answer","text":"兩者相鄰但重點不同。國門廣場連接車站與港區，海洋廣場則更靠近水面與觀景平台。"}}]}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>

    <header class="site-header" data-header>
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="回到頁首">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" role="img">
              <path d="M7 21c5-4 10-4 15 0s10 4 19-1" />
              <path d="M7 29c5-4 10-4 15 0s10 4 19-1" />
            </svg>
          </span>
          <span>
            <strong>基隆海洋廣場</strong>
            <small>獨立旅遊指南</small>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="主要導覽">
          <a href="#highlights">景點特色</a>
          <a href="#best-time">最佳時間</a>
          <a href="#routes">遊覽路線</a>
          <a href="#transport">交通方式</a>
          <a href="#faq">常見問題</a>
        </nav>

        <a class="button button-small button-solid header-cta" href={mapNavigationUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
          開啟地圖
        </a>
      </div>
      <nav class="mobile-anchor-nav" aria-label="頁面段落">
        <a href="#highlights">特色</a>
        <a href="#best-time">時間</a>
        <a href="#gallery">照片</a>
        <a href="#routes">路線</a>
        <a href="#transport">交通</a>
        <a href="#faq">問答</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <picture class="hero-media">
          <source media="(max-width: 700px)" srcset="/images/hero-mobile.webp" />
          <img src="/images/hero-desktop.webp" width="1920" height="1080" alt="基隆海洋廣場標誌、港水與停泊船隻" fetchpriority="high" />
        </picture>
        <div class="hero-shade"></div>
        <div class="shell hero-content">
          <p class="eyebrow"><span></span> 基隆港・仁愛區</p>
          <h1 id="hero-title">從基隆車站<br /><span>走進港灣的第一站</span></h1>
          <p class="hero-lead">沿著木棧平台看船、吹海風、等待港灣亮燈。從基隆火車站南站出口步行約3–5分鐘，不需門票，也不需預約。</p>
          <div class="hero-actions">
            <a class="button button-solid" href={mapNavigationUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
              開啟地圖導航
            </a>
            <a class="button button-ghost" href="#routes">
              查看遊覽路線
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </div>
        </div>
        <div class="hero-photo-credit">實景拍攝：Ralff Nestor Nacor，2025</div>
      </section>

      <section class="quick-facts" aria-label="快速資訊">
        <div class="shell facts-grid">
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span>開放時間</span>
            <strong>24 小時</strong>
          </article>
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v12H3z"/><path d="M7 7V5h10v2M7 13h.01M12 13h.01M17 13h.01"/></svg>
            <span>入場費用</span>
            <strong>免費</strong>
          </article>
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17h16M6 17l2-10h8l2 10M9 11h6M8 21h.01M16 21h.01"/></svg>
            <span>從火車站</span>
            <strong>步行 3–5 分鐘</strong>
          </article>
          <article>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8M9 3v3l-3 5a6 6 0 1 0 12 0l-3-5V3"/></svg>
            <span>建議停留</span>
            <strong>30–60 分鐘</strong>
          </article>
        </div>
      </section>

      <section class="section intro-section" id="highlights">
        <div class="shell split-intro">
          <div class="section-heading sticky-heading">
            <p class="kicker">第一次來，先知道</p>
            <h2>不是大型景區，<br />卻是最自然的基隆開場</h2>
            <p>海洋廣場位在車站、市中心與港水之間。它的價值不是排滿行程，而是讓旅客在抵達後幾分鐘內，就能看見基隆真正的港都樣貌。</p>
          </div>
          <div class="tip-list">
            <article class="tip-card">
              <span class="tip-number">01</span>
              <div><h3>免費，全天開放</h3><p>這裡是沒有固定入口的公共空間。清晨、傍晚或夜間都可前往，活動與施工期間則依現場公告調整。</p></div>
            </article>
            <article class="tip-card">
              <span class="tip-number">02</span>
              <div><h3>黃昏最完整</h3><p>日落前抵達，可以從白天港景一路看到城市燈光亮起，再接著步行前往市中心用餐。</p></div>
            </article>
            <article class="tip-card">
              <span class="tip-number">03</span>
              <div><h3>郵輪不是每天都有</h3><p>大型郵輪需依靠港計畫而定。即使沒有郵輪，仍能觀察港務船、巡防艦艇與港區作業。</p></div>
            </article>
            <article class="tip-card">
              <span class="tip-number">04</span>
              <div><h3>風雨是體驗的一部分</h3><p>港邊風勢與雨勢常比街道明顯。雨後木棧有倒影，也可能濕滑，請穿著防滑鞋並準備雨具。</p></div>
            </article>
          </div>
        </div>
      </section>

      <section class="section experience-section" aria-labelledby="experience-title">
        <div class="shell">
          <div class="section-heading centered-heading">
            <p class="kicker">三種港都體驗</p>
            <h2 id="experience-title">在同一座廣場，看見基隆不同表情</h2>
          </div>
          <div class="experience-grid">
            <article class="experience-card experience-large">
              <img src="/images/photo-day.webp" width="1200" height="900" loading="lazy" alt="基隆海洋廣場木棧平台、標誌與港區船隻" />
              <div class="image-overlay"></div>
              <div class="experience-copy">
                <span>01</span>
                <h3>看港灣與船隻</h3>
                <p>視線越過欄杆，就是港水、船隻與沿山而建的城市。</p>
              </div>
            </article>
            <article class="experience-card">
              <img src="/images/photo-night.webp" width="1200" height="900" loading="lazy" alt="基隆海洋廣場夜間燈光與水面倒影" />
              <div class="image-overlay"></div>
              <div class="experience-copy">
                <span>02</span>
                <h3>等待港灣亮燈</h3>
                <p>入夜後，燈光與濕潤水面形成鮮明的雨港氣氛。</p>
              </div>
            </article>
            <article class="experience-card">
              <img src="/images/photo-overview.webp" width="1200" height="900" loading="lazy" alt="從高處俯瞰基隆海洋廣場與市中心步行空間" />
              <div class="image-overlay"></div>
              <div class="experience-copy">
                <span>03</span>
                <h3>接上城市散步</h3>
                <p>從車站經國門廣場走到港邊，再繼續前往市中心。</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section time-section" id="best-time">
        <div class="shell time-layout">
          <div class="time-copy">
            <p class="kicker">什麼時間去最好？</p>
            <h2>同一個港口，四種觀看方式</h2>
            <div class="time-tabs" role="tablist" aria-label="選擇參觀時段">
              <button type="button" role="tab" aria-selected="true" data-time="day">白天</button>
              <button type="button" role="tab" aria-selected="false" data-time="dusk">黃昏</button>
              <button type="button" role="tab" aria-selected="false" data-time="night">夜晚</button>
              <button type="button" role="tab" aria-selected="false" data-time="rain">雨天</button>
            </div>
            <div class="time-detail" aria-live="polite">
              <p class="time-label" data-time-label>白天・視野最清楚</p>
              <h3 data-time-title>適合第一次辨認港區與船隻</h3>
              <p data-time-description>上午至午後光線較充足，能清楚看見港區建築、船隻與山城輪廓。夏季遮陰有限，請留意防曬與補水。</p>
              <ul data-time-notes>
                <li>適合看船與認識周邊方向</li>
                <li>照片色彩清楚，手機也容易拍攝</li>
                <li>夏季午後體感可能炎熱</li>
              </ul>
            </div>
          </div>
          <figure class="time-visual">
            <img data-time-image src="/images/photo-day.webp" width="1200" height="900" loading="lazy" alt="白天的基隆海洋廣場與港灣" />
            <figcaption data-time-caption>白天可清楚看見港區船隻與城市輪廓。</figcaption>
          </figure>
        </div>
      </section>

      <section class="panorama-section" aria-label="基隆港夜景全景">
        <img src="/images/photo-panorama.webp" width="2400" height="362" loading="lazy" alt="從基隆海洋廣場望向基隆港的寬幅夜景" />
        <div class="panorama-overlay"></div>
        <div class="shell panorama-copy">
          <p>如果只選一個時段</p>
          <h2>日落前 30–45 分鐘抵達</h2>
          <span>從白天港景一路看到城市燈光亮起</span>
        </div>
      </section>

      <section class="section gallery-section" id="gallery">
        <div class="shell">
          <div class="section-heading gallery-heading">
            <div>
              <p class="kicker">真實現場照片</p>
              <h2>白天、夜景與雨港，都不是同一種基隆</h2>
            </div>
            <p>點擊照片可放大查看。所有素材均來自真實拍攝，並在頁尾標示作者與授權。</p>
          </div>
          <div class="gallery-grid">
            <button class="gallery-item gallery-wide" type="button" data-gallery-src="/images/photo-sign.webp" data-gallery-alt="基隆海洋廣場標誌與港區景觀" data-gallery-caption="海洋廣場標誌與基隆港">
              <img src="/images/photo-sign.webp" width="1200" height="675" loading="lazy" alt="基隆海洋廣場標誌與港區景觀" />
              <span>廣場地標</span>
            </button>
            <button class="gallery-item" type="button" data-gallery-src="/images/photo-rain.webp" data-gallery-alt="雨天的基隆海洋廣場木棧平台" data-gallery-caption="雨天木棧平台與城市倒影">
              <img src="/images/photo-rain.webp" width="1200" height="800" loading="lazy" alt="雨天的基隆海洋廣場木棧平台" />
              <span>雨港日常</span>
            </button>
            <button class="gallery-item" type="button" data-gallery-src="/images/photo-night.webp" data-gallery-alt="夜晚基隆海洋廣場的燈光與水面倒影" data-gallery-caption="夜間燈光映在基隆港水面">
              <img src="/images/photo-night.webp" width="1200" height="900" loading="lazy" alt="夜晚基隆海洋廣場的燈光與水面倒影" />
              <span>港灣夜色</span>
            </button>
            <button class="gallery-item gallery-wide" type="button" data-gallery-src="/images/photo-overview.webp" data-gallery-alt="從東岸廣場俯瞰基隆海洋廣場" data-gallery-caption="從高處理解海洋廣場與市中心的位置關係">
              <img src="/images/photo-overview.webp" width="1200" height="900" loading="lazy" alt="從東岸廣場俯瞰基隆海洋廣場" />
              <span>城市位置</span>
            </button>
          </div>
        </div>
      </section>

      <dialog class="lightbox" data-lightbox aria-labelledby="lightbox-caption">
        <button class="lightbox-close" type="button" data-lightbox-close aria-label="關閉照片">×</button>
        <figure>
          <img data-lightbox-image src="" alt="" />
          <figcaption id="lightbox-caption" data-lightbox-caption></figcaption>
        </figure>
      </dialog>

      <section class="section route-section" id="routes">
        <div class="shell">
          <div class="section-heading route-heading">
            <p class="kicker">我有多少時間？</p>
            <h2>選擇停留時間，立刻得到適合的走法</h2>
            <p>不需要複雜的行程規劃。先決定可用時間，再把港邊散步接到你的下一站。</p>
          </div>
          <div class="route-planner">
            <div class="route-tabs" role="tablist" aria-label="選擇可用時間">
              <button type="button" role="tab" aria-selected="true" data-route="30">30 分鐘</button>
              <button type="button" role="tab" aria-selected="false" data-route="60">1 小時</button>
              <button type="button" role="tab" aria-selected="false" data-route="180">3 小時</button>
              <button type="button" role="tab" aria-selected="false" data-route="half">半日</button>
            </div>
            <div class="route-result" aria-live="polite">
              <div class="route-summary">
                <span class="route-badge" data-route-badge>快速看港</span>
                <h3 data-route-title>車站到港邊，完成最精簡的基隆散步</h3>
                <p data-route-description>適合轉車、帶著行李或遇上短暫放晴。重點是快速抵達港邊，不繞遠路。</p>
                <div class="route-meta">
                  <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><b data-route-duration>約 30 分鐘</b></span>
                  <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17h16M6 17l2-10h8l2 10"/></svg><b data-route-style>輕鬆步行</b></span>
                </div>
                <a class="text-link" href={mapNavigationUrl} target="_blank" rel="noopener noreferrer">在地圖查看位置 <span>↗</span></a>
              </div>
              <ol class="route-steps" data-route-steps>
                <li><span>01</span><div><strong>基隆火車站南站出口</strong><small>出站後往港區方向前進</small></div><em>起點</em></li>
                <li><span>02</span><div><strong>國門廣場</strong><small>穿越車站與港區之間的開放空間</small></div><em>約 2 分</em></li>
                <li><span>03</span><div><strong>基隆海洋廣場</strong><small>看港景、拍照，沿木棧平台短暫散步</small></div><em>停留 20 分</em></li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section class="section transport-section" id="transport">
        <div class="shell">
          <div class="section-heading transport-heading">
            <p class="kicker">怎麼抵達？</p>
            <h2>從車站與轉運站出發，都只要幾分鐘</h2>
          </div>
          <div class="transport-grid">
            <article>
              <div class="transport-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="15" rx="3"/><path d="M8 21l2-3M16 21l-2-3M8 8h8M8 13h.01M16 13h.01"/></svg></div>
              <span>搭乘火車</span>
              <h3>由南站出口步行約 3–5 分鐘</h3>
              <p>出站後往港區與國門廣場方向前進，即可接上海洋廣場木棧平台。</p>
            </article>
            <article>
              <div class="transport-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="14" rx="3"/><path d="M7 8h10M7 14h.01M17 14h.01M7 21l2-3M17 21l-2-3"/></svg></div>
              <span>搭乘客運</span>
              <h3>城際轉運站步行約 1–3 分鐘</h3>
              <p>抵達轉運站後，依港區與海洋廣場方向步行，適合從台北搭客運前來。</p>
            </article>
            <article>
              <div class="transport-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16V8l2-4h10l2 4v8M5 12h14M7 16v3M17 16v3M8 8h8M8 15h.01M16 15h.01"/></svg></div>
