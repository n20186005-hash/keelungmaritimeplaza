---
const facilities = [
  {
    type: "洗手間（含無障礙、親子）",
    where: "基隆車站站內、周邊商場與市中心公有場館",
    minutes: "步行約 3–8 分鐘",
    note: "廣場本身是開放空間、未設固定廁所，建議抵達港邊前先使用；夜間以車站與營業中的商場為主。",
  },
  {
    type: "汽車停車",
    where: "車站周邊、市中心與東岸的收費停車場；部分路邊停車格",
    minutes: "步行約 5–10 分鐘",
    note: "假日與連假車位緊張，尖峰時段建議優先搭乘火車或客運；費率與營業時間請以現場告示為準。",
  },
  {
    type: "機車停車",
    where: "車站與市區周邊停放區、路邊停車格",
    minutes: "步行約 1–5 分鐘",
    note: "請依現場標示停放，勿占用行人動線、坡道或無障礙出入口。",
  },
  {
    type: "餐飲",
    where: "廟口周邊小吃、市中心咖啡館、連鎖餐飲與商場美食街",
    minutes: "步行約 5–15 分鐘",
    note: "用餐尖峰容易排隊；雨天室內座位較少，可考慮外帶或避開時段。價格與營業時間依現場為準。",
  },
  {
    type: "住宿",
    where: "車站與市區周邊的商務旅館、背包客棧等類型",
    minutes: "步行約 5–20 分鐘",
    note: "適合安排一晚，分別看清晨與黃昏兩種港景；旺季與連假房價、空房狀況波動較大。",
  },
  {
    type: "商超、藥妝與補給",
    where: "便利商店、超市與藥妝店，分布於車站與市中心沿線",
    minutes: "步行約 3–10 分鐘",
    note: "可補充飲水、輕食、雨具、簡易藥品與行動糧；24 小時據點依各店公告為準。",
  },
  {
    type: "加油與充電",
    where: "市區外圍道路的加油站；停車場與商場周邊的電動車充電設施",
    minutes: "視行車路線而定",
    note: "充電車位可能被占用或需排隊，出發前請先確認充電規格、費率與營業時間。",
  },
  {
    type: "醫療與緊急協助",
    where: "市中心藥局、診所與區域醫院",
    minutes: "步行約 5–15 分鐘",
    note: "建議自備常備藥；若有緊急狀況請撥打 119 或就近向車站服務台、店家求助。",
  },
  {
    type: "金融與提款",
    where: "車站、商場與市中心的金融機構與 ATM",
    minutes: "步行約 3–10 分鐘",
    note: "部分攤商與小店僅收現金，建議備妥現金；行動支付接受度依店家而異。",
  },
  {
    type: "行李寄放",
    where: "車站周邊寄物設施；部分住宿提供寄放服務",
    minutes: "步行約 3–8 分鐘",
    note: "大型行李在木棧平台與窄巷較不便，建議先看港邊再回頭取行李，或先寄放。",
  },
  {
    type: "遮雨、遮蔭與休息座位",
    where: "車站、商場、騎樓與廣場周邊座位區",
    minutes: "步行約 1–5 分鐘",
    note: "廣場為開放空間，遮蔭與避雨設施有限；夏季建議避開正午，雨天留意濕滑。",
  },
  {
    type: "無障礙與嬰兒車動線",
    where: "車站至港邊的平緩動線、坡道銜接處與開放空間",
    minutes: "全程",
    note: "以平緩動線為主，部分路口、坡道與設施可能因施工或活動調整，請以現場公告為準。",
  },
];
---

<div class="facility-block">
  <h3 class="facility-title">周邊設施速查表</h3>
  <p class="facility-intro">
    以下按「設施類型」整理，說明大致的位置方向與步行距離，不指定或推薦任何特定店家與品牌。實際營業時間、費率與開放狀況請以現場公告為準。
  </p>
  <div class="seasons-table-wrap">
    <table class="seasons-table facility-table">
      <thead>
        <tr>
          <th scope="col">設施類型</th>
          <th scope="col">大致位置方向</th>
          <th scope="col">步行距離</th>
          <th scope="col">實用提醒</th>
        </tr>
      </thead>
      <tbody>
        {
          facilities.map((row) => (
            <tr>
              <th scope="row">{row.type}</th>
              <td>{row.where}</td>
              <td>{row.minutes}</td>
              <td>{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
