---
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonLd?: string[];
  mapUrl?: string;
}
const {
  title,
  description,
  path,
  ogImage = "https://keelungmaritimeplaza.com/og/keelung-maritime-plaza-og.jpg",
  jsonLd = [],
  mapUrl,
} = Astro.props;

const canonical = `https://keelungmaritimeplaza.com${path}`;
const mapNavigationUrl =
  "https://www.google.com/maps/dir/?api=1&destination=25.1309627%2C121.7413639";

const pages = [
  { href: "/parking/", label: "停車場攻略" },
  { href: "/transport/", label: "交通攻略" },
  { href: "/night-view/", label: "夜景攻略" },
  { href: "/nearby/", label: "周邊景點" },
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123047" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KeelungMaritimePlaza.com" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={item} />)}
  </head>
  <body class="subpage-body">
    <a class="skip-link" href="#main">跳到主要內容</a>

    <header class="site-header is-scrolled" data-header>
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="返回首頁">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" role="img"><path d="M7 21c5-4 10-4 15 0s10 4 19-1" /><path d="M7 29c5-4 10-4 15 0s10 4 19-1" /></svg>
          </span>
          <span>
            <strong>基隆海洋廣場</strong>
            <small>獨立旅遊指南</small>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="主要導覽">
          {pages.map((p) => <a href={p.href}>{p.label}</a>)}
          <a href="/#faq">常見問題</a>
        </nav>
        <a class="button button-small button-solid header-cta" href={mapUrl ?? mapNavigationUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
          開啟地圖
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand brand-light" href="/">
            <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M7 21c5-4 10-4 15 0s10 4 19-1"/><path d="M7 29c5-4 10-4 15 0s10 4 19-1"/></svg></span>
            <span><strong>基隆海洋廣場</strong><small>獨立旅遊指南</small></span>
          </a>
          <p>本站為獨立旅遊資訊網站，並非基隆市政府、臺灣港務公司或景點官方網站。</p>
        </div>
        <div class="footer-links">
          <h3>站內導覽</h3>
          <a href="/">首頁景點指南</a>
          <a href="/parking/">停車場攻略</a>
          <a href="/transport/">交通攻略</a>
          <a href="/night-view/">夜景攻略</a>
          <a href="/nearby/">周邊景點</a>
          <a href="/#faq">常見問題</a>
          <a href="/privacy/">隱私權說明</a>
          <a href="/image-credits/">圖片來源與授權</a>
          <a href="/sources/">資料來源與更新</a>
        </div>
        <div class="footer-sources">
          <h3>資料來源</h3>
          <a href="/sources/">查看評價、官方旅遊、氣候與歷史資料來源 →</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© 2026 基隆海洋廣場 · 版權所有</span>
      </div>
    </footer>

    <script is:inline>
      const subHeader = document.querySelector('[data-header]');
      if (subHeader) {
        const updateSubHeader = () => subHeader.classList.toggle('is-scrolled', window.scrollY > 20);
        updateSubHeader();
        window.addEventListener('scroll', updateSubHeader, { passive: true });
      }
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
