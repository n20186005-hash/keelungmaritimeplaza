---
const timeline = [
  {
    year: "1626",
    title: "西班牙人進駐雞籠",
    text: "西班牙艦隊北上，在社寮島（今和平島）興建聖救主城並設立據點，北台灣首次出現具規模的外來港口設施，雞籠自此被寫進海上航線圖。",
  },
  {
    year: "1642",
    title: "荷蘭人接手港灣",
    text: "荷蘭東印度公司勢力北上，取代西班牙人在雞籠的駐紮。港灣的控制權幾度更迭，也讓這座天然良港成為各方競逐的門戶。",
  },
  {
    year: "1863",
    title: "開港通商，雞籠設關",
    text: "台灣開港通商後，雞籠正式開埠並設海關，輸出煤、樟腦與茶葉等物產，從沿岸漁港轉身為國際航運網絡中的通商口岸。",
  },
  {
    year: "1875",
    title: "「雞籠」雅化為「基隆」",
    text: "清廷設置基隆廳，取「基地昌隆」之意，把原本的「雞籠」改寫為「基隆」。地名換了一層祝福，港與城的關係卻更加緊密。",
  },
  {
    year: "1884–1885",
    title: "清法戰爭的港都記憶",
    text: "清法戰爭期間法軍一度進犯基隆，劉銘傳督辦台灣防務並在北台灣布防。今日基隆的法軍公墓，即為這段戰事留下的紀念遺跡。",
  },
  {
    year: "1899 起",
    title: "分期築港，成為台灣門戶",
    text: "日治時期展開分期築港工程，填築岸線、興建碼頭、倉儲與鐵路連線，基隆成為台灣對外最主要的吞吐港，城市也沿港而興。",
  },
  {
    year: "1960–1980 年代",
    title: "貨櫃化的黃金時期",
    text: "戰後復建加上貨櫃化作業，基隆港的貨物吞吐量大幅成長，一度躋身世界貨櫃港前列，帶動港邊街區與市中心的繁盛。",
  },
  {
    year: "2010",
    title: "海洋廣場向港面延伸",
    text: "原本屬於小艇碼頭作業岸線的港邊空間，被整理為向水面延伸的木棧觀景平台，也就是今日的海洋廣場——讓港第一次以「可以走進去」的方式回到市民與旅客身邊。",
  },
];

const nameOrigins = [
  {
    label: "通行說法",
    title: "音譯自平埔族語",
    text: "一般認為「雞籠」來自平埔族凱達格蘭（Ketagalan）相關族稱的音轉，早期漢人以台語讀音記為「Ke-lâng」，再寫成「雞籠」。",
  },
  {
    label: "地形說法",
    title: "像雞籠的山與嶼",
    text: "另一種說法認為，外海的基隆嶼與港邊山巒形似覆蓋雞隻的竹籠，因而得名。兩種說法長期並存，地名學上多數支持音譯說。",
  },
];

const stories = [
  {
    label: "地方口傳",
    title: "金雞報曉的港灣",
    text: "基隆地方口傳中，有以「金雞」比喻港灣甦醒的說法，把清晨第一道照進港面的光與報曉的雞鳴連在一起。這類故事屬民間文學，沒有單一版本，讀作討海人對平安出航、滿載歸來的寄託更為貼切。",
  },
  {
    label: "老一輩漁民的說法",
    title: "老鷹盤旋，魚群就來了",
    text: "許多基隆人從小聽長輩說：「看到老鷹繞圈，表示海裡有魚。」今天生態學的解釋是——港區魚屑與穩定的食物來源讓黑鳶（老鷹）長期停留，牠們盤旋多半與覓食氣流有關。說法雖然不同，卻讓基隆成為少數能在市區穩定觀察黑鳶的城市。",
  },
  {
    label: "氣候俗諺",
    title: "「基隆雨」從哪裡來",
    text: "基隆的雨名聞全台，民間也有不少形容落雨不停的俗諺。科學上的主因是冬季東北季風挾帶水氣、被迎風地形抬升而降雨；夏季則以對流性午後雷陣雨與颱風降雨為主，因此形成全年有雨、秋冬更為明顯的「雨港」性格。",
  },
  {
    label: "信仰與街市",
    title: "媽祖廟前的廟口",
    text: "清代創建、主祀天上聖母（媽祖）的慶安宮是港口的信仰中心。早年討海人在出海前後到廟裡祈求平安，廟前聚集的攤商逐漸發展成今日的廟口夜市——從海洋廣場步行可達，正是這條港與信仰、市街交織的日常路線。",
  },
];
---

<section class="section heritage-section" id="heritage" aria-labelledby="heritage-title">
  <div class="shell">
    <div class="section-heading centered-heading">
      <p class="kicker">港與城的故事</p>
      <h2 id="heritage-title">從「雞籠」到基隆港：一座港口的四百年</h2>
      <p>海洋廣場腳下的這片港水，見證了基隆從沿岸口岸到國際商港、再到郵輪與觀光港的轉身。先讀懂這座港，站在木棧平台上的風景會變得更立體。</p>
    </div>

    <ol class="heritage-timeline">
      {
        timeline.map((item) => (
          <li>
            <span class="heritage-year">{item.year}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="heritage-block">
      <h3 class="heritage-subtitle">地名怎麼來的？兩種長期並存的說法</h3>
      <div class="heritage-cards">
        {
          nameOrigins.map((item) => (
            <article>
              <span>{item.label}</span>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <p class="heritage-note">「基隆」一名自 1875 年設廳時正式使用，取「基地昌隆」之意，屬於官方的雅化命名；「雞籠」則仍在地方語彙與舊籍中保留下來。</p>
    </div>

    <div class="heritage-block">
      <h3 class="heritage-subtitle">故事、傳說與地方記憶</h3>
      <div class="heritage-stories">
        {
          stories.map((item) => (
            <article>
              <span>{item.label}</span>
              <h4>{item.title}</h4>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <p class="heritage-note">傳說與俗諺屬於地方記憶的一部分，版本常因地而異；本站僅整理較常見的說法，並以可查證的歷史與科學解釋作為補充，供旅途中延伸閱讀。</p>
    </div>
  </div>
</section>
