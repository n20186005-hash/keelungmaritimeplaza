---
const quarters = [
  {
    season: "春季（3–5 月）",
    weather:
      "鋒面與春雨交替，氣溫約 18–26°C，日照時數回升但早晚仍濕涼；3、4 月容易出現平流霧，遠處山城與船隻輪廓會被削弱。",
    water:
      "春雨把陸源泥沙帶進港內，水色偏黃褐、透明度中等；雨後一至兩日常見漂流木與落葉，通常在數日內隨潮流帶出。",
    wildlife:
      "黑鳶進入繁殖期，求偶與護巢行為頻繁，常在港區上空繞行；4–5 月是過境鳥類北返的季節，港邊消波塊可見鷺科停棲。",
    advice: "適合晨昏散步與生態觀察。建議攜帶輕便雨具與望遠鏡，霧日改拍近景的木棧與船身細節。",
  },
  {
    season: "夏季（6–8 月）",
    weather:
      "濕熱，氣溫約 26–34°C，午後雷陣雨頻繁；7–9 月進入颱風季，港邊風浪變化快，須留意海上與陸上警報。",
    water:
      "水溫偏高、日照強，藻類增生使水色偏綠；颱風或豪雨過後港水混濁，湧浪也較明顯，通常需數日回到平穩。",
    wildlife:
      "黑鳶幼鳥陸續離巢學飛，動作生澀、飛行高度較低；夜鷺與小白鷺多在黃昏時段於岸壁與消波塊覓食。",
    advice: "避開正午，選擇黃昏看船吹風。颱風警報期間請勿前往港邊，風浪大時與護欄保持距離。",
  },
  {
    season: "秋季（9–11 月）",
    weather:
      "東北季風逐步增強，氣溫由 28°C 緩降；降雨日數增加、風勢轉強，是一年中「雨港」性格開始明顯的時候。",
    water:
      "秋雨過後水色轉清、能見度改善；季風帶來湧浪，港內水面容易出現白浪與局部漂流物。",
    wildlife:
      "9–10 月是猛禽過境高峰，港區上空除黑鳶外，有機會見到過境的遷徙性猛禽；魚群隨水溫變化靠近岸邊。",
    advice: "雨港氛圍最濃的季節，適合拍攝濕潤地面與燈光倒影。請準備防風衣物，並留意陣風對雨傘的影響。",
  },
  {
    season: "冬季（12–2 月）",
    weather:
      "東北季風最盛，氣溫約 13–19°C，濕冷且雨日多；強風時體感溫度明顯低於氣溫，是造訪人潮最少的季節。",
    water:
      "水體混合較均勻，水色通常是一年中最深、最清澈的時候；季風強時港內湧浪明顯，岸邊浪花可越過消波塊。",
    wildlife:
      "港區內灣避風、食物穩定，黑鳶族群在冬季往往最為集中；鸕鶿與部分渡冬水鳥也會在港邊出現。",
    advice: "人少、空氣通透，是拍攝與觀察的好時機。務必保暖防風，選擇背風處停留，並穿著防滑鞋。",
  },
];

const indicators = [
  {
    label: "氣象",
    title: "先看風與雨，再看溫度",
    text: "港邊沒有遮擋，體感風速通常比市區明顯。判斷重點是降雨機率、陣風與氣溫三者組合：陣風超過 40 km/h 時，雨傘不易撐穩，雨衣會更實用。",
  },
  {
    label: "水質",
    title: "看的是景觀水色，不是飲用水質",
    text: "港區為商港水域，水色與透明度受潮汐、降雨、潮流與港務作業影響，雨天後通常較混濁。此地僅供觀賞，請勿下水或接觸港水。",
  },
  {
    label: "野生動物",
    title: "把港灣留給在此生活的物種",
    text: "黑鳶、夜鷺與小白鷺是港區最常被觀察到的鳥類。觀察時請保持距離、不餵食、不大聲驅趕，也不使用空拍機干擾飛行。",
  },
];
---

<section class="section quarterly-section" id="quarterly" aria-labelledby="quarterly-title">
  <div class="shell">
    <div class="section-heading centered-heading">
      <p class="kicker">季度遊覽策略</p>
      <h2 id="quarterly-title">氣象、水質、野生動物的綜合分析</h2>
      <p>海洋廣場的體驗由三件事共同決定：天氣怎麼變、港水什麼顏色、動物在不在。下表依基隆地區長期氣候平均（中央氣象署 1991–2020 年氣候資料）與港區長期觀察整理，協助你按季度安排重點。</p>
    </div>

    <div class="quarterly-indicators">
      {
        indicators.map((item) => (
          <article>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>

    <div class="seasons-table-wrap">
      <table class="seasons-table quarterly-table">
        <thead>
          <tr>
            <th scope="col">季度</th>
            <th scope="col">氣象條件</th>
            <th scope="col">港灣水色與能見度</th>
            <th scope="col">野生動物觀察</th>
            <th scope="col">綜合建議</th>
          </tr>
        </thead>
        <tbody>
          {
            quarters.map((row) => (
              <tr>
                <th scope="row">{row.season}</th>
                <td>{row.weather}</td>
                <td>{row.water}</td>
                <td>{row.wildlife}</td>
                <td>{row.advice}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="seasons-note">
      以上為長期氣候平均與季節性趨勢的重點整理，不是即時監測值；同一季度在不同年份仍可能出現明顯差異。出發前請以本頁的即時天氣預報、港區現場公告與主管機關發布為準。港區水域不開放戲水，相關水色描述僅供景觀參考。
    </p>
  </div>
</section>
